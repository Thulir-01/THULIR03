// THULIR03 LIMS — Prisma Schema
// Sprint 1: Core entities only

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenants & Organizations ─────────────────────────────────────────────────

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branches Branch[]
  users    User[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  code           String?
  address        String?
  phone          String?
  email          String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  users User[]
  orders Order[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("branches")
}

// ─── Auth & RBAC ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@unique([slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  isAllowed    Boolean  @default(true) @map("is_allowed")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  roleId         String?   @map("role_id") @db.Uuid
  email          String    @unique
  passwordHash   String    @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  isActive       Boolean   @default(true) @map("is_active")
  totpSecret     String?   @map("totp_secret")
  totpEnabled    Boolean   @default(false) @map("totp_enabled")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  role         Role?        @relation(fields: [roleId], references: [id])
  staffDetail  StaffDetail?
  patient      Patient?
  party        Party?

  @@index([organizationId])
  @@map("users")
}

// ─── Staff / Employee details ────────────────────────────────────────────────
// Thin 1:1 extension of User for NABL report sign-off: pathologist council
// registration no., qualification, designation, and the digital signature
// image that stamps a verified/published report. Extends User, not Party —
// staff are employees, external parties live in the parties table.

model StaffDetail {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  registrationNo    String?  @map("registration_no")
  qualification     String?
  designation       String?
  signatureImageUrl String?  @map("signature_image_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("staff_details")
}

// ─── Patients & Referrers ────────────────────────────────────────────────────

model Patient {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String?
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  dateOfBirth DateTime? @map("date_of_birth")
  ageYears    Int?      @map("age_years")
  ageMonths   Int?      @map("age_months")
  gender      String?
  phone       String?
  email       String?
  address     String?
  abhaAddress String?   @unique @map("abha_address")
  abhaNumber  String?   @map("abha_number")
  patientId   String?   @map("patient_id")
  // Optional portal login link — set when the lab enables patient portal access.
  userId String? @unique @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  orders Order[]
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("patients")
}

// ─── Parties: unified Master Data Management ───────────────────────────────
// ONE shared `parties` table for everything common to every external master
// type (doctors, hospitals, corporates, TPAs, reference labs, consultants) —
// address/contact/GSTIN/bank/documents — plus a thin 1:1 extension table per
// type (PartyDoctorDetail today; the other five types land in later sprints).
// Referrers were migrated here from the legacy `doctors_referrers` table.

enum PartyType {
  doctor
  hospital
  corporate
  insurance_tpa
  reference_lab
  consultant
}

model Party {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  partyType          PartyType @map("party_type")
  name               String
  address            String?
  gstin              String?
  primaryContactName String?   @map("primary_contact_name")
  primaryContactPhone String?  @map("primary_contact_phone")
  primaryContactEmail String?  @map("primary_contact_email")
  bankDetails        Json?     @map("bank_details")
  documents          Json?
  // active | inactive | blacklisted
  status    String   @default("active")
  // Optional portal login link — set when the lab enables referrer portal access.
  userId String? @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  doctorDetail   PartyDoctorDetail?
  orders         Order[] // a party can be the referrer on many orders
  referrerPrices ReferrerPrice[]
  user           User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, partyType])
  @@map("parties")
}

model PartyDoctorDetail {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  partyId            String   @map("party_id") @db.Uuid
  medicalCouncilNo   String?  @map("medical_council_no")
  specialization     String?
  qualification      String?
  commissionPercent  Decimal? @map("commission_percent") @db.Decimal(10, 2)
  commissionSchedule String?  @map("commission_schedule")
  clinicAffiliation  String?  @map("clinic_affiliation")
  // Referrer pricing: "default" | "discount" | "custom" + optional flat %
  pricingMode     String?  @default("default") @map("pricing_mode")
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)

  party Party @relation(fields: [partyId], references: [id])

  @@unique([partyId])
  @@index([tenantId])
  @@map("party_doctor_details")
}

// ─── Masters: Test Catalog ───────────────────────────────────────────────────
// SENAITE-style AnalysisService (TestParameter) + AnalysisProfile (TestPackage),
// plus per-referrer rate cards (ReferrerPrice) for Indian lab billing.

model TestCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  // Auto-code prefix, e.g. "HEM" for Hematology — makes generated codes
  // meaningful ("HEM-014") instead of an arbitrary number.
  codePrefix             String   @default("") @map("code_prefix")
  // Category-level defaults — new parameters in this category are pre-filled
  // with these (still editable per-parameter). Cuts repetitive entry for
  // labs with 200+ parameters where most of a category shares the same
  // sample type / turnaround.
  defaultSampleType      String?  @map("default_sample_type")
  defaultTurnaroundHours Int?     @map("default_turnaround_hours")
  sortOrder              Int      @default(0) @map("sort_order")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  parameters TestParameter[]

  @@index([tenantId])
  @@map("test_categories")
}

/**
 * Persistent per-tenant, per-scope counters for auto-generated masters codes
 * (e.g. "test-param:<categoryId>", "test-package"). A real counter row — NOT
 * count() on existing rows — so deactivating/deleting a row never re-numbers
 * and collides. The $transaction-wrapped upsert makes concurrent generation
 * race-safe (same pattern as the Order/Sample ID fixes).
 */
model MastersSequence {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  scope     String
  nextValue Int    @default(1) @map("next_value")

  @@unique([tenantId, scope])
  @@map("masters_sequences")
}

model TestParameter {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String
  name            String
  categoryId      String   @map("category_id") @db.Uuid
  sampleType      String?
  unit            String?
  // Reference range (numbers) — snapshot onto OrderTest at registration so
  // Result Entry always shows the range the test was booked under.
  refLow  Decimal? @map("ref_low") @db.Decimal(10, 2)
  refHigh Decimal? @map("ref_high") @db.Decimal(10, 2)
  methodology     String?
  turnaroundHours Int?     @map("turnaround_hours")
  defaultPrice    Decimal  @default(0) @map("default_price") @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category       TestCategory      @relation(fields: [categoryId], references: [id])
  packageItems   TestPackageItem[]
  referrerPrices ReferrerPrice[]
  inventoryRequirements TestInventoryRequirement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("test_parameters")
}

model TestPackage {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  // "sum"  -> price = sum of included parameters (resolved per referrer)
  // "fixed"-> price = fixedPrice regardless of line items
  pricingMode String   @default("sum") @map("pricing_mode")
  fixedPrice  Decimal? @map("fixed_price") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items          TestPackageItem[]
  referrerPrices ReferrerPrice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("test_packages")
}

model TestPackageItem {
  id          String   @id @default(uuid()) @db.Uuid
  packageId   String   @map("package_id") @db.Uuid
  parameterId String   @map("parameter_id") @db.Uuid

  package   TestPackage   @relation(fields: [packageId], references: [id])
  parameter TestParameter @relation(fields: [parameterId], references: [id])

  @@unique([packageId, parameterId])
  @@map("test_package_items")
}

model ReferrerPrice {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  partyId     String   @map("party_id") @db.Uuid // the referrer party
  parameterId String?  @map("parameter_id") @db.Uuid // set for a parameter-level override
  packageId   String?  @map("package_id") @db.Uuid   // set for a package-level override
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  party     Party          @relation(fields: [partyId], references: [id])
  parameter TestParameter? @relation(fields: [parameterId], references: [id])
  package   TestPackage?   @relation(fields: [packageId], references: [id])

  @@unique([partyId, parameterId])
  @@unique([partyId, packageId])
  @@index([tenantId])
  @@map("referrer_prices")
}

// ─── Generic Lookup Masters ───────────────────────────────────────────────────
// ONE table for the simple code+name+status lookups (sample types, container
// types, units, methods, payment modes, rejection reasons, discount schemes,
// tax rates) instead of eight bespoke tables. Free-form per-type extras live
// in `metadata` (e.g. container_type: {"colorHex":"#8B5CF6"}, tax_rate:
// {"percent":18}) and are rendered by a config-driven UI.

enum LookupMasterType {
  sample_type
  container_type
  unit
  method
  payment_mode
  rejection_reason
  discount_scheme
  tax_rate
}

model LookupMaster {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  type      LookupMasterType
  code      String
  name      String
  // free-form extra fields per type — e.g. container_type: {"colorHex":"#8B5CF6"},
  // discount_scheme: {"percent":10}, tax_rate: {"percent":18}
  metadata  Json?
  isActive  Boolean           @default(true) @map("is_active")
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, type, code])
  @@index([tenantId, type])
  @@map("lookup_masters")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  referrerPartyId String?   @map("referrer_party_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  orderNumber      String    @unique @map("order_number")
  status           String    @default("pending")
  priority         String    @default("routine")
  category         String?
  sidDate          DateTime? @map("sid_date")
  refNo            String?   @map("ref_no")
  source           String?
  insuranceDetails String?   @map("insurance_details")
  collectionBoy    String?   @map("collection_boy")
  patientType      String?   @map("patient_type")
  ward             String?
  ipOpNo           String?   @map("ip_op_no")
  bedNo            String?   @map("bed_no")
  clinicalRemarks  String?   @map("clinical_remarks")
  sampleCollectDt  DateTime? @map("sample_collect_date")
  billAmount       Decimal?  @default(0) @map("bill_amount") @db.Decimal(10, 2)
  otherCharges     Decimal?  @default(0) @map("other_charges") @db.Decimal(10, 2)
  discountPercent  Decimal?  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount   Decimal?  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountAuth     String?   @map("discount_auth")
  totalAmount      Decimal?  @default(0) @map("total_amount") @db.Decimal(10, 2)
  amountPaid       Decimal?  @default(0) @map("amount_paid") @db.Decimal(10, 2)
  balanceAmount    Decimal?  @default(0) @map("balance_amount") @db.Decimal(10, 2)
  paymentMode      String?   @map("payment_mode")
  bankName         String?   @map("bank_name")
  paymentRef       String?   @map("payment_ref")
  paymentDate      DateTime? @map("payment_date")
  paymentRemarks   String?   @map("payment_remarks")
  deliveryMode     String?   @map("delivery_mode")
  emergency        Boolean   @default(false)
  finalReportDate  DateTime? @map("final_report_date")
  // Workflow: technician verify → pathologist approve (NABL sign-off).
  // The per-test e-signature lives on order_tests (verified_by/verified_at/
  // signature_hash); these order-level fields record the actor + time.
  verifiedBy String?   @map("verified_by") @db.Uuid
  verifiedAt DateTime? @map("verified_at")
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at")
  billHf           Boolean   @default(false) @map("bill_hf")
  consolidatedBill Boolean   @default(false) @map("consolidated_bill")
  remarks          String?
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  patient      Patient   @relation(fields: [patientId], references: [id])
  referrerParty Party?   @relation(fields: [referrerPartyId], references: [id])
  branch       Branch?   @relation(fields: [branchId], references: [id])
  tests        OrderTest[]
  samples      Sample[]

  @@index([tenantId])
  @@map("orders")
}

// ─── Samples ─────────────────────────────────────────────────────────────────
// A sample = one physical tube/specimen. One sample can carry multiple tests
// (CBC + ESR + sugar from a single draw). Sample status lives HERE, not on
// OrderTest, so one tube can never have two contradictory statuses.

model Sample {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  sampleNo        String    @unique @map("sample_no")
  sampleCollectDt DateTime? @map("sample_collect_date")
  collectedBy     String?   @map("collected_by")
  status          String    @default("pending") // pending | received | processing | rejected | completed
  rejectedReason  String?   @map("rejected_reason")
  remarks         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  order Order       @relation(fields: [orderId], references: [id])
  tests OrderTest[]

  @@index([tenantId])
  @@index([orderId])
  @@map("samples")
}

model OrderTest {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  sampleId     String    @map("sample_id") @db.Uuid
  parentTestId String?   @map("parent_test_id") @db.Uuid
  testCode     String    @map("test_code")
  testName     String    @map("test_name")
  isProfile    Boolean   @default(false) @map("is_profile")
  rate         Decimal   @db.Decimal(10, 2)
  status       String    @default("pending")
  result       String?
  unit         String?
  refRange     String?   @map("ref_range")
  refLow       Decimal?  @map("ref_low") @db.Decimal(10, 2)
  refHigh      Decimal?  @map("ref_high") @db.Decimal(10, 2)
  sortOrder    Int?      @default(0) @map("sort_order")
  // NABL e-signature reservation — populated when a pathologist verifies
  // this result. Reserved now so go-live doesn't need a painful migration.
  verifiedBy    String?   @map("verified_by") @db.Uuid
  verifiedAt    DateTime? @map("verified_at")
  signatureHash String?   @map("signature_hash")
  notes         String?

  order        Order      @relation(fields: [orderId], references: [id])
  sample       Sample     @relation(fields: [sampleId], references: [id])
  children     OrderTest[] @relation("TestToChildren")
  parent       OrderTest?  @relation("TestToChildren", fields: [parentTestId], references: [id])

  @@unique([orderId, testCode])
  @@index([tenantId])
  @@map("order_tests")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, action])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─── Inventory: Suppliers, Items, Stock Ledger ───────────────────────────────
// Sprint 11: reagent/consumables inventory. Suppliers are a lightweight contact
// table; InventoryItem holds the on-hand balance; every IN/OUT writes a row to
// InventoryTransaction (the stock ledger) so balances stay auditable.
// TestInventoryRequirement links a TestParameter to the items it consumes
// (qty per test) — the seed for future auto-deduction on result entry.

model InventorySupplier {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  address       String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  items InventoryItem[]

  @@index([tenantId])
  @@map("inventory_suppliers")
}

model InventoryItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  sku            String
  category       String?
  unit           String?
  // Reorder threshold — when quantityOnHand <= minStock the item is flagged.
  minStock       Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(12, 3)
  supplierId     String?  @map("supplier_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  supplier       InventorySupplier?       @relation(fields: [supplierId], references: [id])
  transactions   InventoryTransaction[]
  requirements   TestInventoryRequirement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("inventory_items")
}

// Stock ledger — every movement writes a row; balance = sum of IN − OUT.
model InventoryTransaction {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  itemId      String    @map("item_id") @db.Uuid
  type        String // "in" | "out"
  quantity    Decimal   @db.Decimal(12, 3)
  batchNo     String?   @map("batch_no")
  expiryDate  DateTime? @map("expiry_date")
  unitCost    Decimal?  @map("unit_cost") @db.Decimal(10, 2)
  reference   String?
  notes       String?
  performedBy String?   @map("performed_by") @db.Uuid
  performedAt DateTime  @default(now()) @map("performed_at")

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@index([tenantId, itemId])
  @@map("inventory_transactions")
}

// Which inventory items a test consumes, and how much per test.
model TestInventoryRequirement {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  parameterId String   @map("parameter_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  quantity    Decimal  @default(1) @map("quantity") @db.Decimal(12, 3)

  parameter TestParameter @relation(fields: [parameterId], references: [id])
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([parameterId, itemId])
  @@index([tenantId])
  @@map("test_inventory_requirements")
}

// ─── QC — manual control runs (Westgard) ──────────────────────────────
// Manual-first quality control for small/medium labs with semi-automated
// or manual testing. A QcControl is a control material (one level) assigned
// to a test; technicians enter daily measured values by hand and the Westgard
// engine evaluates them server-side. Instrument streaming is post-V1.

model QcControl {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  testName     String   @map("test_name")
  testCode     String?  @map("test_code")
  level        String   @default("NORMAL") // LOW | NORMAL | HIGH
  name         String // e.g. "Glucose Low Control"
  unit         String?
  assignedMean Decimal  @map("assigned_mean") @db.Decimal(12, 4)
  assignedSd   Decimal  @map("assigned_sd") @db.Decimal(12, 4)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  runs QcRun[]

  @@index([tenantId])
  @@index([tenantId, testName])
  @@map("qc_controls")
}

model QcRun {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  controlId     String   @map("control_id") @db.Uuid
  measuredValue Decimal  @map("measured_value") @db.Decimal(12, 4)
  sdDeviation   Decimal? @map("sd_deviation") @db.Decimal(8, 2)
  status        String   @default("PASS") // PASS | WARN | REJECT
  violations    Json? // string[] of Westgard rule ids hit
  note          String?
  enteredById   String?  @map("entered_by_id") @db.Uuid
  runDate       DateTime @default(now()) @map("run_date")
  createdAt     DateTime @default(now()) @map("created_at")

  control QcControl @relation(fields: [controlId], references: [id])

  @@index([tenantId, controlId, createdAt])
  @@map("qc_runs")
}
