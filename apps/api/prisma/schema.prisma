// THULIR03 LIMS — Prisma Schema
// Sprint 1: Core entities only

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenants & Organizations ─────────────────────────────────────────────────

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branches Branch[]
  users    User[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  code           String?
  address        String?
  phone          String?
  email          String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  users User[]
  orders Order[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("branches")
}

// ─── Auth & RBAC ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@unique([slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  isAllowed    Boolean  @default(true) @map("is_allowed")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  roleId         String?   @map("role_id") @db.Uuid
  email          String    @unique
  passwordHash   String    @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  isActive       Boolean   @default(true) @map("is_active")
  totpSecret     String?   @map("totp_secret")
  totpEnabled    Boolean   @default(false) @map("totp_enabled")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  role         Role?        @relation(fields: [roleId], references: [id])

  @@index([organizationId])
  @@map("users")
}

// ─── Patients & Referrers ────────────────────────────────────────────────────

model Patient {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String?
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  dateOfBirth DateTime? @map("date_of_birth")
  ageYears    Int?      @map("age_years")
  ageMonths   Int?      @map("age_months")
  gender      String?
  phone       String?
  email       String?
  address     String?
  abhaAddress String?   @unique @map("abha_address")
  abhaNumber  String?   @map("abha_number")
  patientId   String?   @map("patient_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  orders Order[]

  @@index([tenantId])
  @@map("patients")
}

// ─── Parties: unified Master Data Management ───────────────────────────────
// ONE shared `parties` table for everything common to every external master
// type (doctors, hospitals, corporates, TPAs, reference labs, consultants) —
// address/contact/GSTIN/bank/documents — plus a thin 1:1 extension table per
// type (PartyDoctorDetail today; the other five types land in later sprints).
// Referrers were migrated here from the legacy `doctors_referrers` table.

enum PartyType {
  doctor
  hospital
  corporate
  insurance_tpa
  reference_lab
  consultant
}

model Party {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  partyType          PartyType @map("party_type")
  name               String
  address            String?
  gstin              String?
  primaryContactName String?   @map("primary_contact_name")
  primaryContactPhone String?  @map("primary_contact_phone")
  primaryContactEmail String?  @map("primary_contact_email")
  bankDetails        Json?     @map("bank_details")
  documents          Json?
  // active | inactive | blacklisted
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  doctorDetail   PartyDoctorDetail?
  orders         Order[] // a party can be the referrer on many orders
  referrerPrices ReferrerPrice[]

  @@index([tenantId, partyType])
  @@map("parties")
}

model PartyDoctorDetail {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  partyId            String   @map("party_id") @db.Uuid
  medicalCouncilNo   String?  @map("medical_council_no")
  specialization     String?
  qualification      String?
  commissionPercent  Decimal? @map("commission_percent") @db.Decimal(10, 2)
  commissionSchedule String?  @map("commission_schedule")
  clinicAffiliation  String?  @map("clinic_affiliation")
  // Referrer pricing: "default" | "discount" | "custom" + optional flat %
  pricingMode     String?  @default("default") @map("pricing_mode")
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)

  party Party @relation(fields: [partyId], references: [id])

  @@unique([partyId])
  @@index([tenantId])
  @@map("party_doctor_details")
}

// ─── Masters: Test Catalog ───────────────────────────────────────────────────
// SENAITE-style AnalysisService (TestParameter) + AnalysisProfile (TestPackage),
// plus per-referrer rate cards (ReferrerPrice) for Indian lab billing.

model TestCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parameters TestParameter[]

  @@index([tenantId])
  @@map("test_categories")
}

model TestParameter {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String
  name            String
  categoryId      String   @map("category_id") @db.Uuid
  sampleType      String?
  unit            String?
  methodology     String?
  turnaroundHours Int?     @map("turnaround_hours")
  defaultPrice    Decimal  @default(0) @map("default_price") @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category       TestCategory      @relation(fields: [categoryId], references: [id])
  packageItems   TestPackageItem[]
  referrerPrices ReferrerPrice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("test_parameters")
}

model TestPackage {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  // "sum"  -> price = sum of included parameters (resolved per referrer)
  // "fixed"-> price = fixedPrice regardless of line items
  pricingMode String   @default("sum") @map("pricing_mode")
  fixedPrice  Decimal? @map("fixed_price") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items          TestPackageItem[]
  referrerPrices ReferrerPrice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("test_packages")
}

model TestPackageItem {
  id          String   @id @default(uuid()) @db.Uuid
  packageId   String   @map("package_id") @db.Uuid
  parameterId String   @map("parameter_id") @db.Uuid

  package   TestPackage   @relation(fields: [packageId], references: [id])
  parameter TestParameter @relation(fields: [parameterId], references: [id])

  @@unique([packageId, parameterId])
  @@map("test_package_items")
}

model ReferrerPrice {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  partyId     String   @map("party_id") @db.Uuid // the referrer party
  parameterId String?  @map("parameter_id") @db.Uuid // set for a parameter-level override
  packageId   String?  @map("package_id") @db.Uuid   // set for a package-level override
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  party     Party          @relation(fields: [partyId], references: [id])
  parameter TestParameter? @relation(fields: [parameterId], references: [id])
  package   TestPackage?   @relation(fields: [packageId], references: [id])

  @@unique([partyId, parameterId])
  @@unique([partyId, packageId])
  @@index([tenantId])
  @@map("referrer_prices")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  referrerPartyId String?   @map("referrer_party_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  orderNumber      String    @unique @map("order_number")
  status           String    @default("pending")
  priority         String    @default("routine")
  category         String?
  sidDate          DateTime? @map("sid_date")
  refNo            String?   @map("ref_no")
  source           String?
  insuranceDetails String?   @map("insurance_details")
  collectionBoy    String?   @map("collection_boy")
  patientType      String?   @map("patient_type")
  ward             String?
  ipOpNo           String?   @map("ip_op_no")
  bedNo            String?   @map("bed_no")
  clinicalRemarks  String?   @map("clinical_remarks")
  sampleCollectDt  DateTime? @map("sample_collect_date")
  billAmount       Decimal?  @default(0) @map("bill_amount") @db.Decimal(10, 2)
  otherCharges     Decimal?  @default(0) @map("other_charges") @db.Decimal(10, 2)
  discountPercent  Decimal?  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount   Decimal?  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountAuth     String?   @map("discount_auth")
  totalAmount      Decimal?  @default(0) @map("total_amount") @db.Decimal(10, 2)
  amountPaid       Decimal?  @default(0) @map("amount_paid") @db.Decimal(10, 2)
  balanceAmount    Decimal?  @default(0) @map("balance_amount") @db.Decimal(10, 2)
  paymentMode      String?   @map("payment_mode")
  bankName         String?   @map("bank_name")
  paymentRef       String?   @map("payment_ref")
  paymentDate      DateTime? @map("payment_date")
  paymentRemarks   String?   @map("payment_remarks")
  deliveryMode     String?   @map("delivery_mode")
  emergency        Boolean   @default(false)
  finalReportDate  DateTime? @map("final_report_date")
  billHf           Boolean   @default(false) @map("bill_hf")
  consolidatedBill Boolean   @default(false) @map("consolidated_bill")
  remarks          String?
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  patient      Patient   @relation(fields: [patientId], references: [id])
  referrerParty Party?   @relation(fields: [referrerPartyId], references: [id])
  branch       Branch?   @relation(fields: [branchId], references: [id])
  tests        OrderTest[]
  samples      Sample[]

  @@index([tenantId])
  @@map("orders")
}

// ─── Samples ─────────────────────────────────────────────────────────────────
// A sample = one physical tube/specimen. One sample can carry multiple tests
// (CBC + ESR + sugar from a single draw). Sample status lives HERE, not on
// OrderTest, so one tube can never have two contradictory statuses.

model Sample {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  sampleNo        String    @unique @map("sample_no")
  sampleCollectDt DateTime? @map("sample_collect_date")
  collectedBy     String?   @map("collected_by")
  status          String    @default("pending") // pending | received | processing | rejected | completed
  rejectedReason  String?   @map("rejected_reason")
  remarks         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  order Order       @relation(fields: [orderId], references: [id])
  tests OrderTest[]

  @@index([tenantId])
  @@index([orderId])
  @@map("samples")
}

model OrderTest {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  sampleId     String    @map("sample_id") @db.Uuid
  parentTestId String?   @map("parent_test_id") @db.Uuid
  testCode     String    @map("test_code")
  testName     String    @map("test_name")
  isProfile    Boolean   @default(false) @map("is_profile")
  rate         Decimal   @db.Decimal(10, 2)
  status       String    @default("pending")
  result       String?
  unit         String?
  refRange     String?   @map("ref_range")
  refLow       Decimal?  @map("ref_low") @db.Decimal(10, 2)
  refHigh      Decimal?  @map("ref_high") @db.Decimal(10, 2)
  sortOrder    Int?      @default(0) @map("sort_order")
  // NABL e-signature reservation — populated when a pathologist verifies
  // this result. Reserved now so go-live doesn't need a painful migration.
  verifiedBy    String?   @map("verified_by") @db.Uuid
  verifiedAt    DateTime? @map("verified_at")
  signatureHash String?   @map("signature_hash")
  notes         String?

  order        Order      @relation(fields: [orderId], references: [id])
  sample       Sample     @relation(fields: [sampleId], references: [id])
  children     OrderTest[] @relation("TestToChildren")
  parent       OrderTest?  @relation("TestToChildren", fields: [parentTestId], references: [id])

  @@unique([orderId, testCode])
  @@index([tenantId])
  @@map("order_tests")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, action])
  @@index([entity, entityId])
  @@map("audit_logs")
}
